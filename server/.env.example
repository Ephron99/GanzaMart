# ── Database (MySQL Server — NOT MySQL Workbench) ─────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change_me
DB_NAME=GanzaMart_db

# ── Server ─────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Auth ───────────────────────────────────────────────────────────
# Generate your own long random secret, e.g. PowerShell:
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); ($b | % { $_.ToString('x2') }) -join ''
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=1d
